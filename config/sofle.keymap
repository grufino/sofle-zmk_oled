#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// #include <dt-bindings/zmk/rgb.h>
// #include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        // Encoder rotation -> mouse wheel scroll (clockwise scrolls down).
        // &msc values are a speed (units/s) emitted every 16ms tick, so the
        // default SCRL_* (10) rounds to 0 on a short encoder tap. 20ms fits
        // exactly one tick; 100 * 0.016 = 1.6 -> 1 wheel step per detent.
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-100)>, <&msc MOVE_Y(100)>;
            tap-ms = <20>;
        };
    };

    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ---------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // | GRAVE |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | LCTRL |  Z  |  X  |  C   |  V   |  B   |  PLAY  |  | MSNCTL|  N   |  M    |  ,    |  .   |   /   |   =   |
            //        LCTRL  | ALT | GUI  | LOWER| SH/SP|  |  SH/RET | RAISE| LG(ENT)|LG(SPC)|  RCTRL 
            // Encoders: left = volume, right = mouse-wheel scroll. PLAY / MSNCTL are the encoder clicks.

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4            &kp N5                                          &kp N6     &kp N7         &kp N8         &kp N9   &kp N0    &kp MINUS
&kp GRAVE  &kp Q   &kp W   &kp E     &kp R             &kp T                                           &kp Y      &kp U          &kp I          &kp O    &kp P     &kp BSPC
&kp TAB    &kp A   &kp S   &kp D     &kp F             &kp G                                           &kp H      &kp J          &kp K          &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V             &kp B      &kp C_PLAY_PAUSE   &kp LC(UP)        &kp N      &kp M          &kp COMMA      &kp DOT  &kp FSLH  &kp EQUAL
   &kp LCTRL   &kp LALT  &kp LEFT_COMMAND  &mo LOWER  &mt LSHFT SPACE    &mt RSHFT RET     &mo RAISE  &kp LG(ENTER)  &kp LG(SPACE)  &kp RCTRL
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_encoder>;
        };

        lower_layer {
            display-name = "lower";

            // ---------------------------------------------------------------------------------------------------------------------
            // |  ESC  |  F1  |  F2   | MSNCTL|G(S(4))|  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // | GRAVE |  1   |G(A(UP))|  ]   | C(R) |  }   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
            // |  TAB  |  !   |G(A(DN))|  #   |  $   |  %   |                   |  ^   |  4    |  5    |  6   |   )   |   |   |
            // |       | UNDO |  [    |  ]    |  {   |  }   |        |  |       |  0   |  1    |  2    |  3   |   0   |       |
            //                |       |       |      |      |        |  |       |      |       |       |    
            // Encoders: left = volume, right = page up / page down.

            bindings = <
&kp ESC    &kp F1      &kp F2                  &kp LC(UP_ARROW)   &kp LG(LS(NUMBER_4))  &kp F5                             &kp F6     &kp F7        &kp F8        &kp F9        &kp F10   &kp F11
&kp GRAVE  &kp N1      &kp LG(LA(UP_ARROW))    &kp RIGHT_BRACKET  &kp LC(R)             &kp RIGHT_BRACE                    &kp N6     &kp N7        &kp N8        &kp N9        &kp N0    &kp BACKSPACE
&kp TAB    &kp EXCL    &kp LG(LA(DOWN_ARROW))  &kp HASH           &kp DLLR              &kp PRCNT                          &kp CARET  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp RPAR  &kp PIPE
&trans     &kp K_UNDO  &kp LEFT_BRACKET        &kp RIGHT_BRACKET  &kp LEFT_BRACE        &kp RBRC         &trans    &trans  &kp N0     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0    &trans
                                   &trans  &trans     &trans                &trans           &trans    &trans  &trans     &trans        &trans        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "raise";

            // ---------------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | MENU  |       |      |                | PGUP |      |   ^   |      |   0   | BKSPC |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |    
            // Encoders: left = volume, right = page up / page down.

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans     &trans    &trans    &trans     &trans   &trans
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans                          &kp PG_UP  &trans    &kp UP    &trans     &kp N0   &kp BACKSPACE
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK                        &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &trans        &trans    &trans  &trans     &trans    &trans    &trans     &trans   &trans
                          &trans  &trans  &trans        &trans        &trans    &trans  &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         |         | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |    

            display-name = "adjust";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none         &none    &none  &none  &none  &none  &none  &none  &none
                          &none  &none    &none         &none         &none    &none  &none  &none  &none  &none
            >;
        };
    };
};
